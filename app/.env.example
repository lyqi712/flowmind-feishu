# Model provider: local | openai-chat | openai-responses | anthropic | gemini | ollama | azure-openai | custom-http
MODEL_PROVIDER=openai-chat
MODEL_BASE_URL=https://your-relay.example/v1
MODEL_API_KEY=
MODEL_DEFAULT=your-model-id
MODEL_TIMEOUT_MS=120000
MODEL_RETRIES=2
MODEL_RETRY_DELAY_MS=500
MODEL_FALLBACK_TO_LOCAL=true

# Feishu connector
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
